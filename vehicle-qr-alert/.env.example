# Copy this file to .env and adjust as needed.
# The app runs with zero setup using the defaults below (SQLite, AI disabled).

ENV=development

# Defaults to a local SQLite file. For Postgres, use:
# DATABASE_URL=postgresql://user:password@localhost:5432/vehicle_qr_alert
DATABASE_URL=sqlite:///./vehicle_qr_alert.db

SECRET_KEY=change-this-to-a-long-random-string-in-production

# AI: disabled by default -> risk scoring falls back to the built-in
# rule-based keyword matcher, and the authenticity/fraud check falls
# back to a rule-based heuristic (see app/services/ai_service.py).
#
# Setting AI_ENABLED=true + a real API key turns on the
# authenticity check's real vision-AI call (it reads the reporter's
# message AND the attached photo, if any, and judges whether they
# genuinely match). Risk scoring's AI path is left as a documented
# stub, not live -- see _ai_score() for why.
#
# AI_PROVIDER picks which vision AI to use:
#   anthropic -- Claude vision API. Get a key at
#     https://console.anthropic.com -- this is a PAID API, you need
#     billing credits loaded even to test it (requires
#     `pip install -r requirements-ai.txt`).
#   gemini    -- Google Gemini API. Get a free key at
#     https://aistudio.google.com/app/apikey -- has a genuine free
#     tier (Flash models), no credit card needed. No extra package
#     install required (uses httpx, already a base dependency).
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=

# If true, ONLY reports the authenticity check confirms "likely_genuine"
# are forwarded to the vehicle owner -- everything else (needs_review,
# likely_prank) is suppressed silently (no SMS sent), though it still
# shows up in the owner's dashboard for manual review.
# If false (default), EVERY report reaches the owner, clearly labeled,
# so a real emergency is never dropped just because the authenticity
# check got it wrong.
NOTIFY_ONLY_ON_VERIFIED=false
